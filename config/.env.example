# 复制本文件为 .env 并填写，install.ps1 会读取并渲染占位符。未填的可选项留空即可。

# ---- 模型 provider（至少填一组）----
MY_PROVIDER_API_KEY=          # 主力模型 provider 的 key（自定义 provider 用）
MY_PROVIDER_BASE_URL=         # 自定义 provider 的 baseURL，如 https://xxx/v1
MAIN_MODEL=                   # 主力对话模型，格式 provider/model-id
SMALL_MODEL=                  # 小模型（标题/摘要等轻量任务），格式 provider/model-id
P1P5_MODEL=                   # agent 块（P1.5/P2）用的推理模型，格式 provider/model-id
AGNES_API_KEY=                # 如用 agnes 填这里
GITHUB_TOKEN=                 # 如用 github-copilot 填这里

# ---- 可选：本地服务 ----
DP_BRAIN_ENDPOINT=            # 可选，本地 dp-brain shim 端点
GATEWAY_ENDPOINT=             # 可选，本地网关端点
OLLAMA_ENDPOINT=              # 可选，本地 ollama 端点（nuphus-mcp 视觉用）
LOCAL_RAG_SERVER_PATH=        # 可选，local-rag 的 rag_server.py 绝对路径

# ---- AGENTS.md 占位符（安装时渲染）----
BRAIN_NOTES=                  # 笔记目录路径
BRAIN_INBOX=                  # 收件箱目录路径
KNOWLEDGE_EXPORT_ROOT=        # 知识导出根目录
DEEPFREEZE_SCRIPT=            # deepfreeze.ps1 绝对路径
REVIEW_DIR=                   # 评审目录
DEEPSEEK_BRAIN_DIR=           # dp 大脑目录
SHIM_START_CMD=               # shim 启动命令

# ---- 身份与角色（安装时替换 AGENTS.md 中的占位符）----
USER=                         # 安装时替换 AGENTS.md 里的 $USER 称呼
ORCHESTRATOR=                 # 编排者角色名
HEAVY_IMPL=                   # 重装实现角色名
IDE_IMPL=                     # IDE 实现角色名
REVIEWER=                     # 评审员角色名
